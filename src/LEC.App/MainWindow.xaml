<!-- src/LEC.App/MainWindow.xaml -->
<Window x:Class="LEC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:LEC.App.Converters"
        Title="LEC — Local Email Client" Height="720" Width="1100"
        Icon="Assets/LEC_Logo.png">
    <Window.Resources>
        <conv:LoadableToBrushConverter x:Key="LoadableToBrushConverter"/>
        <conv:SpecialToFontWeightConverter x:Key="SpecialToFontWeightConverter"/>
        <conv:HasAttachmentToVisibilityConverter x:Key="HasAttachmentToVisibilityConverter"/>
        <conv:NotLoadableTooltipConverter x:Key="NotLoadableTooltipConverter"/>
        <conv:RecoveredKindToRowBrushConverter x:Key="RecoveredKindToRowBrushConverter"/>
        <conv:AttachmentListToVisibilityConverter x:Key="AttachmentListToVisibilityConverter"/>
        <conv:SpecialToVisibilityConverter x:Key="SpecialToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="SearchToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="#E8E8E8" BorderBrush="#B0B0B0" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3874CB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3874CB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Abrir Perfil..." Click="OpenProfile_Click"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
            <StatusBarItem Content="{Binding MessageList.StatusText}"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding OpenProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <DockPanel Background="#DCE3EA" Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22" Margin="2"
                                            Click="CloseProfile_Click" ToolTip="Fechar perfil"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </DockPanel>
                                <TreeView ItemsSource="{Binding FolderTree.RootNodes}"
                                          SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Nova pasta..." Click="NewTopLevelFolder_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{Binding IsLoadable, Converter={StaticResource LoadableToBrushConverter}}"
                                                       FontWeight="{Binding IsSpecial, Converter={StaticResource SpecialToFontWeightConverter}}"
                                                       ToolTip="{Binding IsLoadable, Converter={StaticResource NotLoadableTooltipConverter}}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Nova subpasta aqui..." Click="NewSubfolder_Click"/>
                                                        <MenuItem Header="Mover pasta..." Click="MoveFolder_Click"
                                                                  Visibility="{Binding IsSpecial, Converter={StaticResource SpecialToVisibilityConverter}}"/>
                                                        <MenuItem Header="Apagar pasta" Click="DeleteFolder_Click"
                                                                  Visibility="{Binding IsSpecial, Converter={StaticResource SpecialToVisibilityConverter}}"/>
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button x:Name="ScavengeButton" Content="Procurar mensagens recuperáveis nesta pasta"
                                Click="ScavengeButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="CancelScavengeButton" Content="Cancelar" Margin="8,0,0,0"
                                Click="CancelScavengeButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="RecoverableBar" DockPanel.Dock="Top" Background="#E8F0FE" Padding="6"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="ToggleRecoverableButton" DockPanel.Dock="Right"
                                    Click="ToggleRecoverableButton_Click"/>
                            <TextBlock x:Name="RecoverableCountText" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="4" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="SearchFieldSender" Content="Remetente" GroupName="MessageSearchField" Tag="Sender"
                                         Style="{StaticResource SearchToggleButtonStyle}" Checked="SearchFieldRadio_Checked"/>
                            <RadioButton x:Name="SearchFieldSubject" Content="Assunto" GroupName="MessageSearchField" Tag="Subject" IsChecked="True"
                                         Style="{StaticResource SearchToggleButtonStyle}" Checked="SearchFieldRadio_Checked"/>
                            <RadioButton x:Name="SearchFieldContent" Content="Conteúdo" GroupName="MessageSearchField" Tag="Content"
                                         Style="{StaticResource SearchToggleButtonStyle}" Checked="SearchFieldRadio_Checked"/>
                            <TextBlock Text="Carregando conteúdo…" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontStyle="Italic" Foreground="Gray"
                                       Visibility="{Binding MessageList.IsContentLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>
                    <ListView x:Name="MessageListView"
                              ItemsSource="{Binding MessageList.Messages}"
                              SelectionMode="Extended"
                              SelectionChanged="MessageListView_SelectionChanged"
                              KeyDown="MessageListView_KeyDown"
                              GridViewColumnHeader.Click="MessageListView_ColumnHeaderClick"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{Binding RecoveredKind, Converter={StaticResource RecoveredKindToRowBrushConverter}}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Mover para...">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <EventSetter Event="Click" Handler="MoveMessage_Click"/>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Apagar">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <EventSetter Event="Click" Handler="DeleteMessage_Click"/>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="📎" Width="24">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="📎"
                                                       Visibility="{Binding HasAttachment, Converter={StaticResource HasAttachmentToVisibilityConverter}}"
                                                       ToolTip="Mensagem tem anexo"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="SenderColumn" DisplayMemberBinding="{Binding SenderName}" Width="200">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{Binding DataContext.MessageList.SenderColumnHeader, ElementName=MessageListView, FallbackValue=De}"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Header="Assunto" DisplayMemberBinding="{Binding Subject}" Width="350"/>
                                <GridViewColumn x:Name="DateColumn" DisplayMemberBinding="{Binding Date}" Width="140">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{Binding DataContext.MessageList.DateColumnHeader, ElementName=MessageListView, FallbackValue=Data}"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>

                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" x:Name="ImagesBlockedBar" Background="#FFF3CD" Padding="6" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Exibir imagens" Click="ShowImages_Click"/>
                            <TextBlock Text="Imagens remotas foram bloqueadas por padrão." VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="#EFEFEF" Padding="6"
                            Visibility="{Binding MessageReader.Current.Attachments,
                                         Converter={StaticResource AttachmentListToVisibilityConverter},
                                         FallbackValue=Collapsed}">
                        <ItemsControl ItemsSource="{Binding MessageReader.Current.Attachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="6,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Size, StringFormat={}{0:N0} bytes}" Foreground="Gray" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Button Content="Salvar" Margin="6,0,0,0" Click="SaveAttachment_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <wv2:WebView2 x:Name="ReaderWebView"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
