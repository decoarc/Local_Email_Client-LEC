<!-- src/LEC.App/MainWindow.xaml -->
<Window x:Class="LEC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:LEC.App.Converters"
        Title="LEC — Local Email Client" Height="720" Width="1100">
    <Window.Resources>
        <conv:LoadableToBrushConverter x:Key="LoadableToBrushConverter"/>
        <conv:SpecialToFontWeightConverter x:Key="SpecialToFontWeightConverter"/>
        <conv:HealthToVisibilityConverter x:Key="HealthToVisibilityConverter"/>
        <conv:NotLoadableTooltipConverter x:Key="NotLoadableTooltipConverter"/>
        <conv:RecoveredKindToVisibilityConverter x:Key="RecoveredKindToVisibilityConverter"/>
        <conv:RecoveredKindToLabelConverter x:Key="RecoveredKindToLabelConverter"/>
        <conv:RecoveredKindToRowBrushConverter x:Key="RecoveredKindToRowBrushConverter"/>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Abrir Perfil..." Click="OpenProfile_Click"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
            <StatusBarItem Content="{Binding MessageList.StatusText}"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding OpenProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <DockPanel Background="#DCE3EA" Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22" Margin="2"
                                            Click="CloseProfile_Click" ToolTip="Fechar perfil"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </DockPanel>
                                <TreeView ItemsSource="{Binding FolderTree.RootNodes}"
                                          SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{Binding IsLoadable, Converter={StaticResource LoadableToBrushConverter}}"
                                                       FontWeight="{Binding IsSpecial, Converter={StaticResource SpecialToFontWeightConverter}}"
                                                       ToolTip="{Binding IsLoadable, Converter={StaticResource NotLoadableTooltipConverter}}"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button x:Name="ScavengeButton" Content="Procurar mensagens recuperáveis nesta pasta"
                                Click="ScavengeButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="CancelScavengeButton" Content="Cancelar" Margin="8,0,0,0"
                                Click="CancelScavengeButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="RecoverableBar" DockPanel.Dock="Top" Background="#E8F0FE" Padding="6"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="ToggleRecoverableButton" DockPanel.Dock="Right"
                                    Click="ToggleRecoverableButton_Click"/>
                            <TextBlock x:Name="RecoverableCountText" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ListView x:Name="MessageListView"
                              ItemsSource="{Binding MessageList.Messages}"
                              SelectionChanged="MessageListView_SelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{Binding RecoveredKind, Converter={StaticResource RecoveredKindToRowBrushConverter}}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="!" Width="24">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Health, StringFormat={}{0}}"
                                                       Visibility="{Binding Health, Converter={StaticResource HealthToVisibilityConverter}}"
                                                       Foreground="DarkOrange" FontWeight="Bold" ToolTip="Mensagem com atributo fora do intervalo esperado — dado parcialmente recuperado."/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Origem" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RecoveredKind, Converter={StaticResource RecoveredKindToLabelConverter}}"
                                                       Visibility="{Binding RecoveredKind, Converter={StaticResource RecoveredKindToVisibilityConverter}}"
                                                       FontStyle="Italic"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="De" DisplayMemberBinding="{Binding SenderName}" Width="200"/>
                                <GridViewColumn Header="Assunto" DisplayMemberBinding="{Binding Subject}" Width="350"/>
                                <GridViewColumn Header="Data" DisplayMemberBinding="{Binding Date}" Width="140"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>

                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" x:Name="ImagesBlockedBar" Background="#FFF3CD" Padding="6" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Exibir imagens" Click="ShowImages_Click"/>
                            <TextBlock Text="Imagens remotas foram bloqueadas por padrão." VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <wv2:WebView2 x:Name="ReaderWebView"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
